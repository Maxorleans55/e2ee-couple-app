{
  "expo": {
    "name": "UsTwo",
    "slug": "e2ee-couple-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Uses Face ID to protect your private keys."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF5EF"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidKeyStore": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#FBF5EF",
          "dark": {
            "backgroundColor": "#150F17"
          }
        }
      ]
    ],
    "extra": {
      "e2e": {
        "allowlistPath": "./relay-server/allowlist.json"
      }
    },
    "icon": "./assets/icon.png",
    "scheme": "ustwo"
  }
}
